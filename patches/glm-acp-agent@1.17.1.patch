+    const raw = env[name];
+    if (raw === undefined)
+        return fallback;
+    const trimmed = raw.trim();
+    if (!/^\d+$/.test(trimmed)) {
+        warn(`glm-acp-agent: ignoring invalid ${name} value "${raw}"; using ${fallback}`);
+        return fallback;
+    }
+    const value = Number(trimmed);
+    if (!Number.isSafeInteger(value) || value <= 0 || value > max) {
